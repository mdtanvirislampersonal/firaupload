# ===========================================================================
# File Manager - Environment Variables Example
# ===========================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# ARCHITECTURE: This file manager has NO database. All state — files,
# metadata, users, activity logs, file versions — lives in a GitHub
# repository. You must configure the GitHub section below.
# ===========================================================================

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32  (must be >= 32 chars)
AUTH_SECRET=""

# --- Admin ----------------------------------------------------------------
# The username suggested on the first-admin setup screen.
ADMIN_USERNAME="admin"

# --- GitHub (REQUIRED — this is your data store) --------------------------
# Set GITHUB_ENABLED="true" to enable GitHub-backed storage.
GITHUB_ENABLED="true"
GITHUB_OWNER=""
GITHUB_REPOSITORY=""
GITHUB_BRANCH="main"
# IMPORTANT: Use a fine-grained PAT with `Contents: Read and Write` on the repo.
# NEVER share or commit this token. Keep it in .env only.
GITHUB_TOKEN=""

# --- Google Indexing (optional) ------------------------------------------
# Set GOOGLE_INDEXING_ENABLED="false" to disable. When disabled the panel shows
# a clear "disabled" state and never fakes a successful response.
GOOGLE_SEARCH_CONSOLE_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_INDEXING_ENABLED="false"

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_SIZE_MB="100"

# --- Trusted Hosts (optional) --------------------------------------------
# Comma-separated list of allowed hosts for sitemap/robots URL generation.
# Leave empty to trust the incoming Host header.
TRUSTED_HOSTS=""
